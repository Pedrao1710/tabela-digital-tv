# Código de implantação e dados persistentes do painel.
TABELA_APP_DIR=/opt/tabela-digital
TABELA_DATA_DIR=/var/lib/tabela-digital

# Use um remote do tipo crypt do rclone apontando para o Google Drive.
# O nome abaixo é apenas exemplo; configure o remote no servidor.
RCLONE_REMOTE=drive-crypt:backups/tabela-digital

