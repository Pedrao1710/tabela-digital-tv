# Primeiro inicie restrito ao próprio servidor e troque as senhas pelo túnel SSH.
TABELA_BIND=127.0.0.1
TABELA_PORT=8088
TABELA_VERSION=1.0.1
TABELA_ORIGIN=http://127.0.0.1:8088

# Deixe vazio em acesso direto. Preencha somente após confirmar o IP EXATO
# do proxy no socket da aplicação e fazê-lo sobrescrever X-Real-IP.
TABELA_TRUSTED_PROXIES=

# Diretório persistente do estado do painel e ponto de montagem da fonte SMB, no host Linux.
TABELA_DATA_DIR=/var/lib/tabela-digital
PRICE_SOURCE_DIR=/mnt/tabela-precos

